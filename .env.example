# Aplicação
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Postgres local (docker-compose)
DATABASE_URL=postgres://zapdetaily:zapdetaily@localhost:5432/zapdetaily
DB_MIGRATION_TIMEOUT_MS=120000

# Plano ativo: basic, standard ou plus
ZD_PLAN=basic
ZD_ADMIN_SESSION_TTL_SECONDS=28800

# Opcional para npm run admin:create; se omitidos, o terminal pergunta no terminal.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
ADMIN_TENANT_SLUG=tenant-demo

# Configurações iniciais do tenant; WhatsApp vazio desativa o botão.
ZD_TENANT_NAME=Tenant Demo
ZD_TENANT_SLOGAN=Seu cuidado, do seu jeito.
ZD_TENANT_LOGO_URL=
ZD_TENANT_COLORS='{"primary":"#94a3b8","accent":"#cbd5e1","background":"#0f172a","foreground":"#e2e8f0","surface":"#1e293b"}'
ZD_TENANT_WHATSAPP=
ZD_TENANT_ADDRESS=
ZD_TENANT_INSTAGRAM=
ZD_TENANT_BUSINESS_HOURS='{"segunda":{"abertura":"08:00","fechamento":"18:00"},"domingo":{"fechado":true}}'
ZD_TENANT_TIMEZONE=America/Sao_Paulo
ZD_TENANT_VEHICLE_SIZES='[{"key":"moto","label":"Moto"},{"key":"pequeno","label":"Pequeno"},{"key":"medio","label":"Médio"},{"key":"grande","label":"Grande"}]'
ZD_BOOKING_INTERVAL_MINUTES=30
ZD_BOOKING_CAPACITY=1

# O runner valida o ambiente no boot; use valores locais somente neste arquivo de exemplo.
